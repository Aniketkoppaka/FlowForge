datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum WorkflowRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum NodeExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
  CANCELLED
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  DELIVERED
  DEAD_LETTER
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @unique @db.VarChar(255)
  name         String?       @db.VarChar(100)
  passwordHash String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  workflows    Workflow[]
  sessions     Session[]
  runs         WorkflowRun[]

  @@index([email])
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  jti       String    @unique @db.VarChar(64)
  userId    String    @db.Uuid
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([jti, revokedAt, expiresAt])
}

model Workflow {
  id                     String            @id @default(uuid()) @db.Uuid
  userId                 String            @db.Uuid
  name                   String            @db.VarChar(255)
  description            String?           @db.Text
  draftDefinition        Json              @default("{\"schemaVersion\": 1, \"nodes\": [], \"edges\": []}")
  publishedVersionId     String?           @db.Uuid
  publishedVersionNumber Int?
  deletedAt              DateTime          ?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  user                   User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  versions               WorkflowVersion[] @relation("WorkflowVersions")
  publishedVersion       WorkflowVersion?  @relation("PublishedWorkflowVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  runs                   WorkflowRun[]

  @@index([userId, deletedAt, updatedAt(sort: Desc)])
  @@index([id, userId, deletedAt])
}

model WorkflowVersion {
  id            String        @id @default(uuid()) @db.Uuid
  workflowId    String        @db.Uuid
  versionNumber Int
  contentHash   String        @db.VarChar(64)
  definition    Json
  createdAt     DateTime      @default(now())

  workflow      Workflow      @relation("WorkflowVersions", fields: [workflowId], references: [id], onDelete: Restrict)
  publishedFor  Workflow[]    @relation("PublishedWorkflowVersion")
  runs          WorkflowRun[]

  @@unique([workflowId, versionNumber])
  @@index([workflowId, contentHash])
  @@index([workflowId, createdAt(sort: Desc)])
}

model WorkflowRun {
  id                String             @id @default(uuid()) @db.Uuid
  workflowId        String             @db.Uuid
  workflowVersionId String             @db.Uuid
  versionNumber     Int
  userId            String             @db.Uuid
  status            WorkflowRunStatus  @default(QUEUED)
  triggerPayload    Json               @default("{}")
  idempotencyKey    String?            @db.VarChar(128)
  attemptCount      Int                @default(0)
  maxAttempts       Int                @default(3)
  workerLeaseOwner  String?            @db.VarChar(128)
  workerLeaseUntil  DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  durationMs        Int?
  error             Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  workflow          Workflow           @relation(fields: [workflowId], references: [id], onDelete: Restrict)
  workflowVersion   WorkflowVersion    @relation(fields: [workflowVersionId], references: [id], onDelete: Restrict)
  user              User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  nodeExecutions    NodeExecution[]
  attempts          ExecutionAttempt[]

  @@unique([userId, workflowId, idempotencyKey])
  @@index([workflowId, userId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, workerLeaseUntil])
}

model NodeExecution {
  id             String              @id @default(uuid()) @db.Uuid
  runId          String              @db.Uuid
  nodeId         String              @db.VarChar(100)
  nodeType       String              @db.VarChar(50)
  label          String              @db.VarChar(100)
  status         NodeExecutionStatus @default(PENDING)
  attemptCount   Int                 @default(0)
  startedAt      DateTime?
  completedAt    DateTime?
  durationMs     Int?
  input          Json?
  output         Json?
  selectedBranch String?             @db.VarChar(16)
  skipReason     String?             @db.Text
  error          Json?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  run            WorkflowRun         @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, nodeId])
  @@index([runId, createdAt])
}

model ExecutionAttempt {
  id            String            @id @default(uuid()) @db.Uuid
  runId         String            @db.Uuid
  attemptNumber Int
  workerId      String            @db.VarChar(128)
  status        WorkflowRunStatus
  startedAt     DateTime          @default(now())
  completedAt   DateTime?
  error         Json?

  run           WorkflowRun       @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, attemptNumber])
  @@index([runId])
}

model OutboxEvent {
  id            String            @id @default(uuid()) @db.Uuid
  eventType     String            @db.VarChar(64)
  aggregateId   String            @db.Uuid
  payload       Json
  status        OutboxEventStatus @default(PENDING)
  attempts      Int               @default(0)
  maxAttempts   Int               @default(5)
  nextAttemptAt DateTime          @default(now())
  lockedBy      String?           @db.VarChar(128)
  lockedUntil   DateTime?
  deliveredAt   DateTime?
  lastError     String?           @db.Text
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status, nextAttemptAt, lockedUntil])
  @@index([aggregateId])
}
