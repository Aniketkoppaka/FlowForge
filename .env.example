# Database Configuration
DATABASE_URL="postgresql://flowforge:flowforge_dev_password@localhost:5432/flowforge?schema=public"

# Redis Configuration
REDIS_URL="redis://localhost:6379"

# API Configuration
API_PORT=4000
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"

# Authentication & Security Secrets (Replace in production with minimum 32-byte high-entropy secrets)
SESSION_SECRET="replace-with-secure-minimum-32-character-secret-in-env"
CSRF_SECRET="replace-with-secure-minimum-32-character-csrf-secret"

# Frontend Configuration
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Worker Configuration
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_MS=1500
WORKER_LEASE_DURATION_MS=60000
ENABLE_OUTBOUND_HTTP="false"
