{
  "name": "flowforge",
  "version": "0.1.0",
  "private": true,
  "description": "FlowForge Visual Workflow Automation Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "npm --workspace=@flowforge/database run db:generate",
    "db:migrate:dev": "npm --workspace=@flowforge/database run db:migrate:dev",
    "db:migrate:deploy": "npm --workspace=@flowforge/database run db:migrate:deploy"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.15.0",
    "prettier": "^3.4.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.16.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "body-parser": "^1.20.9"
  },
  "packageManager": "npm@11.6.2"
}
